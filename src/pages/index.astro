---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProfileHero from "@/components/home/ProfileHero.astro";
import ProductsSection from "@/components/home/ProductsSection.astro";
import { getHomeStructuredData } from "@/utils/getHomeStructuredData";
import { SITE } from "@/config";
import profileImage from "@/assets/images/profile-2.png";

// データをインポート
import {
  journals,
  internationalConferences,
  domesticConferences,
  myNames,
} from "@/data/publications";
import { awards, grants } from "@/data/profile";
const highlightMyName = (authors: string) => {
  let result = authors;
  myNames.forEach(name => {
    result = result.replace(
      new RegExp(name, "g"),
      `<u class="underline underline-offset-2">${name}</u>`
    );
  });
  return result;
};

const homeStructuredData = getHomeStructuredData(profileImage.src);
---

<Layout
  title={`${SITE.title} | 九州大学 荒川研究室`}
  description={SITE.desc}
  structuredData={homeStructuredData}
>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <ProfileHero />

    <!-- About Section -->
    <section id="about-detail" class="pt-12 pb-6">
      <h2 class="section-title">About</h2>

      <div class="space-y-6">
        <!-- <div>
          <h3 class="text-lg font-medium mb-2 text-accent">Education</h3>
          <ul class="space-y-2">
            {education.map((edu) => (
              <li>
                <p class="font-medium">{edu.institution}</p>
                <p class="text-sm text-foreground/60">{edu.degree}, {edu.period}</p>
              </li>
            ))}
          </ul>
        </div> -->
        {
          awards.length > 0 && (
            <div>
              <h3 class="mb-2 text-lg font-medium text-accent">Awards</h3>
              <ul class="space-y-2">
                {awards.map(award => (
                  <li class="pub-item">
                    <p class="font-medium whitespace-pre-line">{award.title}</p>
                    <p class="text-sm text-foreground/60">
                      {award.organization}, {award.year}, {award.month}
                    </p>
                    {award.link && (
                      <div class="mt-1 flex gap-2 text-sm">
                        <a
                          href={award.link}
                          class="link-pill"
                        >
                          Link
                        </a>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          grants.length > 0 && (
            <div>
              <h3 class="mb-2 text-lg font-medium text-accent">Grants</h3>
              <ul class="space-y-2">
                {grants.map(grant => (
                  <li class="pub-item">
                    <p class="font-medium whitespace-pre-line">{grant.title}</p>
                    <p class="text-sm text-foreground/60">
                      {grant.organization}, {grant.period}
                    </p>
                    {grant.link && (
                      <div class="mt-1 flex gap-2 text-sm">
                        <a
                          href={grant.link}
                          class="link-pill"
                        >
                          Link
                        </a>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    <!-- Publications Section -->
    <section id="publications" class="border-b border-border pt-12 pb-6">
      <h2 class="section-title">Publications</h2>

      {
        journals.length > 0 && (
          <div class="mb-8">
            <h3 class="mb-4 text-lg font-medium text-accent">Journal Papers</h3>
            <ul class="space-y-4">
              {journals.map(pub => (
                <li class="pub-item">
                  <p class="font-medium">{pub.title}</p>
                  <p
                    class="text-sm text-foreground/70"
                    set:html={highlightMyName(pub.authors)}
                  />
                  <p class="text-sm text-foreground/70">
                    {pub.venue}, {pub.year}, {pub.month}
                  </p>
                  {pub.links && pub.links.doi && (
                    <p class="text-sm text-foreground/60">
                      DOI: {pub.links.doi}.
                    </p>
                  )}
                  {pub.award && (
                    <p class="mt-1">
                      <span class="award-badge"> {pub.award}</span>
                    </p>
                  )}
                  {pub.links && (
                    <div class="mt-1 flex gap-2 text-sm">
                      {pub.links.paper && (
                        <a
                          href={pub.links.paper}
                          class="link-pill"
                        >
                          Paper
                        </a>
                      )}
                      {pub.links.slide && (
                        <a
                          href={pub.links.slide}
                          class="link-pill"
                        >
                          Slide
                        </a>
                      )}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        internationalConferences.length > 0 && (
          <div class="mb-8">
            <h3 class="mb-4 text-lg font-medium text-accent">
              International Conference
            </h3>
            <ul class="space-y-4">
              {internationalConferences.map(pub => (
                <li class="pub-item">
                  <p class="font-medium">{pub.title}</p>
                  <p
                    class="text-sm text-foreground/70"
                    set:html={highlightMyName(pub.authors)}
                  />
                  <p class="text-sm text-foreground/70">
                    {pub.venue}, {pub.year}, {pub.month}
                  </p>
                  {pub.links && pub.links.doi && (
                    <p class="text-sm text-foreground/60">
                      DOI: {pub.links.doi}.
                    </p>
                  )}
                  {pub.award && (
                    <p class="mt-1">
                      <span class="award-badge"> {pub.award}</span>
                    </p>
                  )}
                  {pub.links && (
                    <div class="mt-1 flex gap-2 text-sm">
                      {pub.links.paper && (
                        <a
                          href={pub.links.paper}
                          class="link-pill"
                        >
                          Paper
                        </a>
                      )}
                      {pub.links.slide && (
                        <a
                          href={pub.links.slide}
                          class="link-pill"
                        >
                          Slide
                        </a>
                      )}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        domesticConferences.length > 0 && (
          <div class="mb-8">
            <h3 class="mb-4 text-lg font-medium text-accent">
              Domestic Conference
            </h3>
            <ul class="space-y-4">
              {domesticConferences.map(pub => (
                <li class="pub-item">
                  <p class="font-medium">{pub.title}</p>
                  <p
                    class="text-sm text-foreground/70"
                    set:html={highlightMyName(pub.authors)}
                  />
                  <p class="text-sm text-foreground/70">
                    {pub.venue}, {pub.year}, {pub.month}
                  </p>
                  {pub.links && pub.links.doi && (
                    <p class="text-sm text-foreground/60">
                      DOI: {pub.links.doi}.
                    </p>
                  )}
                  {pub.award && (
                    <p class="mt-1">
                      <span class="award-badge"> {pub.award}</span>
                    </p>
                  )}
                  {pub.links && (
                    <div class="mt-1 flex gap-2 text-sm">
                      {pub.links.paper && (
                        <a
                          href={pub.links.paper}
                          class="link-pill"
                        >
                          Paper
                        </a>
                      )}
                      {pub.links.slide && (
                        <a
                          href={pub.links.slide}
                          class="link-pill"
                        >
                          Slide
                        </a>
                      )}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        journals.length === 0 &&
          internationalConferences.length === 0 &&
          domesticConferences.length === 0 && (
            <p class="text-foreground/60">Coming soon...</p>
          )
      }
    </section>

    <ProductsSection />
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
